{
  "terminal": {
    "match": "word",
    "default": "tier",
    "always_confirm": [
      "mv",
      "pip",
      "hf",
      "nano",
      "micro",
      "sed",
      "podman (pull|build)",
      "docker (pull|build)",
      "inotify",
      "git clone",
      "sudo",
      "systemctl",
      "tmp",
      ".cache",
      "var",
      ".local",
      "curl -L",
      "restart",
      "stop"
    ],
    "always_allow": [
      "ls",
      "grep",
      "diff",
      "cat",
      "bat",
      "sudo journalctl",
      "nvidia-smi (--format|RUSD|SOC)"
    ],
    "always_deny": [
      "rm",
      "pkill",
      "kill",
      "reboot",
      "unlock",
      "lock",
      "chown",
      "chmod",
      "chattr",
      "sudo (chmod|chattr|mv|cp|nix|shutdown|ls|cat|nano|sed|rm)",
      "npm",
      "rsync",
      "ln",
      "flatpak",
      "apt",
      "unzip",
      "zip",
      "7z",
      "(conversation|workflow|preset|voices|reference_audio)",
      "Documents",
      "iphone",
      "data-export",
      "data_export",
      "vault",
      "gocrypt",
      "nvidia-smi (-p|-l|-i|-r|-c|-t|-g|--auto|--power)"
    ]
  }
}
